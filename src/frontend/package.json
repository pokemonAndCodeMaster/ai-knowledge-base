    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@tanstack/vue-table": "^8.21.3",
    "@tanstack/vue-virtual": "^3.13.31",
    "axios": "^1.7.9",
    "echarts": "^6.0.0",
    "gridstack": "^12.6.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.10",
    "typescript": "~5.7.2",
    "vite": "^7.2.2",
    "vitest": "^4.0.12",
    "vue-tsc": "^3.1.4"
  }
}
